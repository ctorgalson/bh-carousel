{
  "name": "@bedlamhotel/bh-carousel",
  "type": "module",
  "version": "0.11.2",
  "description": "An implementation of the WAI ARIA 'Carousel' pattern.",
  "homepage": "https://github.com/ctorgalson/bh-carousel",
  "bugs": {
    "url": "https://github.com/ctorgalson/bh-carousel/issues"
  },
  "license": "GPL-2.0-or-later",
  "sideEffects": false,
  "main": "./dist/js/bh-carousel.js",
  "module": "./dist/js/bh-carousel.esm.js",
  "types": "./dist/js/bh-carousel.d.ts",
  "exports": {
    ".": {
      "types": "./dist/js/bh-carousel.d.ts",
      "import": "./dist/js/bh-carousel.esm.js",
      "browser": "./dist/js/bh-carousel.js",
      "require": "./dist/js/bh-carousel.cjs"
    },
    "./css/*": "./dist/css/*"
  },
  "keywords": [
    "carousel",
    "accessibility",
    "a11y",
    "ARIA"
  ],
  "author": "Christopher Torgalson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ctorgalson/bh-carousel.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "concurrently --raw npm:build:*",
    "build:css": "postcss src/bh-carousel.css -o dist/css/bh-carousel.min.css && npm run copy:css",
    "build:ts": "rollup --config && npm run copy:js",
    "copy:css": "for d in ./dist/css/ ./demo/css/ ; do cp -v src/bh-carousel.css \"$d\" ; done",
    "copy:js": "cp -v ./dist/js/bh-carousel.min.js ./demo/js",
    "build:docs": "typedoc --logLevel Verbose --coverageLabel 'Docs'",
    "format": "concurrently --raw npm:format:*",
    "format:ts": "prettier -w src/bh-carousel.ts",
    "format:css": "prettier -w src/bh-carousel.css",
    "format:html": "prettier -w demo/index.html",
    "start": "npm run build ; npm run watch",
    "serve": "serve demo -p 3000",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "watch": "concurrently --kill-others --raw npm:watch:* npm:serve",
    "watch:css": "onchange 'src/**/*.css' -- npm run build:css",
    "watch:md": "onchange 'README.md' -- npm run build:docs",
    "watch:ts": "onchange 'src/**/*.ts' -- concurrently --raw npm:build:ts npm:build:docs"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^9.1.0",
    "cssnano": "^7.0.6",
    "jsdom": "^30.0.1",
    "onchange": "^7.1.0",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0",
    "prettier": "^3.4.2",
    "rollup": "^4.28.1",
    "serve": "^14.2.4",
    "typedoc": "^0.28.20",
    "typedoc-plugin-coverage": "^4.0.3",
    "typedoc-plugin-markdown": "^4.13.0",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typedoc-plugin-rename-defaults": "^0.7.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
